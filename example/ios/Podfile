# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# 🔑 Resolve truvideo-react-core-sdk dynamically (same idea as turbo example)
def truvideo_core_sdk_pod_root
  explicit = ENV['TRUVIDEO_CORE_SDK_PATH']
  return File.expand_path(explicit) if explicit && !explicit.strip.empty?

  ios_dir = __dir__

  # optional pointer file
  pointer = File.expand_path('../.truvideo-core-sdk-path', ios_dir)
  if File.file?(pointer)
    from_file = File.read(pointer).strip
    unless from_file.empty?
      candidate = File.expand_path(from_file, File.dirname(pointer))
      return candidate if File.exist?(File.join(candidate, 'truvideo-react-core-sdk.podspec'))
    end
  end

  # common locations
  candidates = [
    File.expand_path('../node_modules/truvideo-react-core-sdk', ios_dir),
    File.expand_path('../../node_modules/truvideo-react-core-sdk', ios_dir),
    File.expand_path('../../../node_modules/truvideo-react-core-sdk', ios_dir),
    File.expand_path('../../truvideo-react-core-sdk', ios_dir),
  ]

  candidates.find do |dir|
    Dir.exist?(dir) && File.exist?(File.join(dir, 'truvideo-react-core-sdk.podspec'))
  end
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TruVideoReactCameraSdkExample' do
  # ✅ Resolve core SDK
  core_root = truvideo_core_sdk_pod_root
  unless core_root
    raise Pod::Informative, <<~MSG
      Missing `truvideo-react-core-sdk`.

      Fix options:
        • Install package (npm/yarn)
        • Place repo locally next to project
        • export TRUVIDEO_CORE_SDK_PATH=/absolute/path
        • echo /path > example/.truvideo-core-sdk-path
    MSG
  end

  # ✅ Link core SDK properly
  pod 'truvideo-react-core-sdk', :path => core_root

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TruVideoReactCameraSdkExampleTests' do
    inherit! :complete
    # Pods for testing
  end 

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
